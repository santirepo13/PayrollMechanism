# Fix f-string syntax error and hide fines from model receipt when disabled
calculator_gui = '''
import tkinter as tk
from tkinter import ttk, messagebox
from datetime import datetime
import os
from reportlab.pdfgen import canvas
from reportlab.lib.pagesizes import letter

class BroadSpecCalculator:
    def __init__(self, root):
        self.root = root
        self.root.title("BroadSpec Payment Calculator")
        self.root.geometry("1200x750")
        self.root.resizable(False, False)
        
        # Configure style
        style = ttk.Style()
        style.theme_use('clam')
        
        # Main container with scrollbar
        main_canvas = tk.Canvas(root)
        main_scrollbar = ttk.Scrollbar(root, orient="vertical", command=main_canvas.yview)
        scrollable_frame = ttk.Frame(main_canvas)
        
        scrollable_frame.bind(
            "<Configure>",
            lambda e: main_canvas.configure(scrollregion=main_canvas.bbox("all"))
        )
        
        main_canvas.create_window((0, 0), window=scrollable_frame, anchor="nw")
        main_canvas.configure(yscrollcommand=main_scrollbar.set)
        
        main_canvas.pack(side="left", fill="both", expand=True)
        main_scrollbar.pack(side="right", fill="y")
        
        main_frame = ttk.Frame(scrollable_frame, padding="20")
        main_frame.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))
        
        # Title
        title = ttk.Label(main_frame, text="BROADSPEC PAYMENT CALCULATOR", 
                         font=('Arial', 16, 'bold'))
        title.grid(row=0, column=0, columnspan=3, pady=(0, 20))
        
        # Input fields column
        input_frame = ttk.Frame(main_frame)
        input_frame.grid(row=1, column=0, sticky=(tk.N, tk.W), padx=(0, 20))
        
        row = 0
        
        # Model ID
        ttk.Label(input_frame, text="Model ID #:", font=('Arial', 10)).grid(row=row, column=0, sticky=tk.W, pady=5)
        self.model_id = ttk.Entry(input_frame, width=20)
        self.model_id.grid(row=row, column=1, sticky=tk.W, pady=5)
        row += 1
        
        # Model name
        ttk.Label(input_frame, text="MODELO:", font=('Arial', 10)).grid(row=row, column=0, sticky=tk.W, pady=5)
        self.modelo = ttk.Entry(input_frame, width=20)
        self.modelo.grid(row=row, column=1, sticky=tk.W, pady=5)
        row += 1
        
        # TRM inputs
        ttk.Label(input_frame, text="TRM $COP (NOT NULL):", font=('Arial', 10)).grid(row=row, column=0, sticky=tk.W, pady=5)
        self.trm_cop = ttk.Entry(input_frame, width=20)
        self.trm_cop.grid(row=row, column=1, sticky=tk.W, pady=5)
        row += 1
        
        ttk.Label(input_frame, text="BTK TRM $COP:", font=('Arial', 10)).grid(row=row, column=0, sticky=tk.W, pady=5)
        self.btk_trm_cop = ttk.Entry(input_frame, width=20)
        self.btk_trm_cop.grid(row=row, column=1, sticky=tk.W, pady=5)
        row += 1
        
        # Tokens
        ttk.Label(input_frame, text="TKS (tokens):", font=('Arial', 10)).grid(row=row, column=0, sticky=tk.W, pady=5)
        self.tks = ttk.Entry(input_frame, width=20)
        self.tks.grid(row=row, column=1, sticky=tk.W, pady=5)
        row += 1
        
        # Percentage
        ttk.Label(input_frame, text="Percentage:", font=('Arial', 10)).grid(row=row, column=0, sticky=tk.W, pady=5)
        self.percentage = ttk.Combobox(input_frame, width=17, state='readonly')
        self.percentage['values'] = ('60%', '70%', '75%')
        self.percentage.current(1)
        self.percentage.bind('<<ComboboxSelected>>', self.on_percentage_change)
        self.percentage.grid(row=row, column=1, sticky=tk.W, pady=5)
        row += 1
        
        # Other Site USD
        ttk.Label(input_frame, text="Other Site USD:", font=('Arial', 10)).grid(row=row, column=0, sticky=tk.W, pady=5)
        self.other_site_usd = ttk.Entry(input_frame, width=20)
        self.other_site_usd.insert(0, "0")
        self.other_site_usd.grid(row=row, column=1, sticky=tk.W, pady=5)
        row += 1
        
        # Previous Fortnight
        ttk.Label(input_frame, text="Dólares Quincena Anterior:", font=('Arial', 10)).grid(row=row, column=0, sticky=tk.W, pady=5)
        self.dolares_quincena = ttk.Entry(input_frame, width=20)
        self.dolares_quincena.insert(0, "0")
        self.dolares_quincena.grid(row=row, column=1, sticky=tk.W, pady=5)
        row += 1
        
        # Advances section
        ttk.Label(input_frame, text="Adelantos:", font=('Arial', 10, 'bold')).grid(row=row, column=0, columnspan=2, sticky=tk.W, pady=(10,5))
        row += 1
        
        # Store advances entries
        self.adelantos_entries = []
        
        # Frame for advances list
        adelantos_frame = ttk.Frame(input_frame)
        adelantos_frame.grid(row=row, column=0, columnspan=2, sticky=tk.W, pady=5)
        
        self.adelantos_list_frame = ttk.Frame(adelantos_frame)
        self.adelantos_list_frame.pack()
        
        add_adelanto_btn = ttk.Button(adelantos_frame, text="+ Add Adelanto", command=self.add_adelanto_field)
        add_adelanto_btn.pack(pady=5)
        row += 1
        
        # Fines section
        self.fines_label = ttk.Label(input_frame, text="Multas (Studio only):", font=('Arial', 10, 'bold'))
        self.fines_label.grid(row=row, column=0, columnspan=2, sticky=tk.W, pady=(10,5))
        row += 1
        
        self.fines_count_label = ttk.Label(input_frame, text="Number of Fines (30k each):", font=('Arial', 9))
        self.fines_count_label.grid(row=row, column=0, sticky=tk.W, pady=5)
        self.fines_count = ttk.Entry(input_frame, width=20)
        self.fines_count.insert(0, "0")
        self.fines_count.grid(row=row, column=1, sticky=tk.W, pady=5)
        row += 1
        
        self.custom_fine_label = ttk.Label(input_frame, text="OR Custom Fine Amount (COP):", font=('Arial', 9))
        self.custom_fine_label.grid(row=row, column=0, sticky=tk.W, pady=5)
        self.custom_fine = ttk.Entry(input_frame, width=20)
        self.custom_fine.grid(row=row, column=1, sticky=tk.W, pady=5)
        row += 1
        
        # Buttons frame
        buttons_frame = ttk.Frame(input_frame)
        buttons_frame.grid(row=row, column=0, columnspan=2, pady=20)
        
        calc_btn = ttk.Button(buttons_frame, text="Calculate", command=self.calculate)
        calc_btn.grid(row=0, column=0, padx=5)
        
        clear_btn = ttk.Button(buttons_frame, text="Clear", command=self.clear_fields)
        clear_btn.grid(row=0, column=1, padx=5)
        
        save_btn = ttk.Button(buttons_frame, text="Save PDF", command=self.save_pdf)
        save_btn.grid(row=0, column=2, padx=5)
        
        # Full receipt (middle)
        full_receipt_frame = ttk.LabelFrame(main_frame, text="Full Receipt (Internal)", padding="10")
        full_receipt_frame.grid(row=1, column=1, sticky=(tk.W, tk.E, tk.N, tk.S), padx=10)
        
        self.full_receipt_text = tk.Text(full_receipt_frame, width=40, height=35, font=('Courier', 8))
        self.full_receipt_text.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))
        
        scrollbar1 = ttk.Scrollbar(full_receipt_frame, orient=tk.VERTICAL, command=self.full_receipt_text.yview)
        scrollbar1.grid(row=0, column=1, sticky=(tk.N, tk.S))
        self.full_receipt_text['yscrollcommand'] = scrollbar1.set
        
        # Simplified receipt (right side)
        simple_receipt_frame = ttk.LabelFrame(main_frame, text="Model Receipt (Screenshot)", padding="10")
        simple_receipt_frame.grid(row=1, column=2, sticky=(tk.W, tk.E, tk.N, tk.S))
        
        self.simple_receipt_text = tk.Text(simple_receipt_frame, width=35, height=35, font=('Courier', 9))
        self.simple_receipt_text.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))
        
        # Store current calculation data
        self.current_data = None
        
        # Add first adelanto field
        self.add_adelanto_field()
        
        # Initialize fines state
        self.on_percentage_change(None)
    
    def on_percentage_change(self, event):
        """Enable/disable fines based on percentage selection"""
        perc_str = self.percentage.get()
        percentage = float(perc_str.strip('%')) / 100
        
        if percentage > 0.60:
            # Disable fines for home workers (70% and 75%)
            self.fines_count.config(state='disabled')
            self.custom_fine.config(state='disabled')
            self.fines_count.delete(0, tk.END)
            self.fines_count.insert(0, "0")
            self.custom_fine.delete(0, tk.END)
            self.fines_label.config(text="Multas (Disabled - Home Worker)")
        else:
            # Enable fines for studio workers (60%)
            self.fines_count.config(state='normal')
            self.custom_fine.config(state='normal')
            self.fines_label.config(text="Multas (Studio only):")
    
    def add_adelanto_field(self):
        """Add a new adelanto entry with date and amount"""
        frame = ttk.Frame(self.adelantos_list_frame)
        frame.pack(pady=2)
        
        date_entry = ttk.Entry(frame, width=12)
        date_entry.insert(0, datetime.now().strftime("%Y-%m-%d"))
        date_entry.pack(side=tk.LEFT, padx=2)
        
        amount_entry = ttk.Entry(frame, width=12)
        amount_entry.insert(0, "0")
        amount_entry.pack(side=tk.LEFT, padx=2)
        
        remove_btn = ttk.Button(frame, text="X", width=3, 
                               command=lambda: self.remove_adelanto_field(frame))
        remove_btn.pack(side=tk.LEFT, padx=2)
        
        self.adelantos_entries.append((date_entry, amount_entry, frame))
    
    def remove_adelanto_field(self, frame):
        """Remove an adelanto entry"""
        for i, (date_e, amount_e, f) in enumerate(self.adelantos_entries):
            if f == frame:
                self.adelantos_entries.pop(i)
                frame.destroy()
                break
        
        # Keep at least one entry
        if len(self.adelantos_entries) == 0:
            self.add_adelanto_field()
        
    def clear_fields(self):
        """Clear all fields except TRM and BTK TRM"""
        self.model_id.delete(0, tk.END)
        self.modelo.delete(0, tk.END)
        self.tks.delete(0, tk.END)
        self.percentage.current(1)
        self.other_site_usd.delete(0, tk.END)
        self.other_site_usd.insert(0, "0")
        self.dolares_quincena.delete(0, tk.END)
        self.dolares_quincena.insert(0, "0")
        
        # Clear adelantos
        for date_e, amount_e, frame in self.adelantos_entries:
            frame.destroy()
        self.adelantos_entries = []
        self.add_adelanto_field()
        
        # Clear fines
        self.fines_count.delete(0, tk.END)
        self.fines_count.insert(0, "0")
        self.custom_fine.delete(0, tk.END)
        
        self.full_receipt_text.delete(1.0, tk.END)
        self.simple_receipt_text.delete(1.0, tk.END)
        self.current_data = None
        
        # Reset fines state based on percentage
        self.on_percentage_change(None)
        
    def calculate(self):
        try:
            # Get input values
            model_id = self.model_id.get().strip()
            trm_cop = float(self.trm_cop.get())
            btk_trm_cop = float(self.btk_trm_cop.get())
            modelo = self.modelo.get()
            tks = int(self.tks.get())
            
            perc_str = self.percentage.get()
            percentage = float(perc_str.strip('%')) / 100
            
            other_site_usd = float(self.other_site_usd.get())
            dolares_quincena = float(self.dolares_quincena.get())
            
            # Process adelantos
            adelantos_list = []
            total_adelantos = 0
            for date_e, amount_e, _ in self.adelantos_entries:
                date_val = date_e.get().strip()
                amount_val = float(amount_e.get() or 0)
                if amount_val > 0:
                    adelantos_list.append((date_val, amount_val))
                    total_adelantos += amount_val
            
            # Process fines (only if 60%)
            if percentage > 0.60:
                multas_total = 0
                fines_display = "N/A (Home Worker)"
                show_fines = False
            else:
                show_fines = True
                custom_fine_val = self.custom_fine.get().strip()
                if custom_fine_val:
                    multas_total = float(custom_fine_val)
                    fines_display = f"Custom: {multas_total:,.0f} COP"
                else:
                    fines_count = int(self.fines_count.get() or 0)
                    multas_total = fines_count * 30000
                    fines_display = f"{fines_count} fines x 30,000 = {multas_total:,.0f} COP"
            
            # Calculations
            trm_broadspec_cop = trm_cop - 300
            costo_transferencia_usd = 6.99 + (6.99 * 0.19)
            costo_transferencia_cop = costo_transferencia_usd * btk_trm_cop
            
            usd = tks / 20
            neto = usd * percentage
            totalusd_precalc = neto + other_site_usd + dolares_quincena
            
            valor_broadspec_cop = (totalusd_precalc * trm_broadspec_cop) - costo_transferencia_cop
            total_cop = valor_broadspec_cop - total_adelantos - multas_total
            
            current_date = datetime.now().strftime("%B %d, %Y")
            
            # Store data for PDF
            self.current_data = {
                'model_id': model_id,
                'modelo': modelo,
                'tks': tks,
                'date': current_date,
                'trm_cop': trm_cop,
                'trm_broadspec_cop': trm_broadspec_cop,
                'percentage': percentage,
                'total_cop': total_cop,
                'adelantos_list': adelantos_list,
                'total_adelantos': total_adelantos,
                'multas_total': multas_total,
                'fines_display': fines_display,
                'show_fines': show_fines
            }
            
            # Generate adelantos text for receipts
            adelantos_text = ""
            for date_val, amount_val in adelantos_list:
                adelantos_text += f"    {date_val}: ${amount_val:,.2f} COP" + "\\n"
            if not adelantos_text:
                adelantos_text = "    None\\n"
            
            # Generate FULL receipt
            equals_line = "=" * 50
            full_receipt = f"""
{equals_line}
            PAYMENT RECEIPT
              BROADSPEC
{equals_line}
Model ID: {model_id}
Model: {modelo}
Date: {current_date}
{equals_line}
 
INPUT VALUES:
  TRM $COP: {trm_cop:,.2f}
  TRM BROADSPEC $COP: {trm_broadspec_cop:,.2f}
  Tokens (TKS): {tks:,}
  Percentage: {percentage:.0%}
  Other Site USD: ${other_site_usd:,.2f}
  Previous Fortnight USD: ${dolares_quincena:,.2f}
 
ADELANTOS:
{adelantos_text}  Total: ${total_adelantos:,.2f} COP
 
MULTAS:
  {fines_display}
 
CALCULATED VALUES:
  USD from Tokens: ${usd:,.2f}
  Net Amount USD: ${neto:,.2f}
  Total USD (Pre-calc): ${totalusd_precalc:,.2f}
  Total USD in COP: {totalusd_precalc * trm_broadspec_cop:,.2f}
  Transfer Cost: {costo_transferencia_cop:,.2f} COP
 
FINAL CALCULATION:
  BroadSpec Value: {valor_broadspec_cop:,.2f} COP
  Less Adelantos: {total_adelantos:,.2f} COP
  Less Multas: {multas_total:,.2f} COP
  
  TOTAL PAYMENT: {total_cop:,.2f} COP
  TOTAL PAYMENT: ${total_cop/trm_broadspec_cop:,.2f} USD
 
{equals_line}
     Payment calculation completed
{equals_line}
"""
            
            # Generate adelantos text for simple receipt
            adelantos_simple = ""
            for date_val, amount_val in adelantos_list:
                adelantos_simple += f"  {date_val}: ${amount_val:,.0f}" + "\\n"
            
            # Generate SIMPLIFIED receipt (hide fines if disabled)
            equals_line_simple = "=" * 40
            if show_fines:
                multas_section = f"Multas: ${multas_total:,.0f} COP" + "\\n\\n"
            else:
                multas_section = ""
            
            simple_receipt = f"""
            
            
        BROADSPEC
      Payment Summary
 
 
{equals_line_simple}
 
Date: {current_date}
 
ID: {model_id}
 
Model: {modelo}
 
TRM Official: ${trm_cop:,.2f} COP
 
TRM BroadSpec: ${trm_broadspec_cop:,.2f} COP
 
Tokens: {tks:,}
 
Percentage: {percentage:.0%}
 
Adelantos:
{adelantos_simple if adelantos_simple else "  None" + "\\n"}
{multas_section}Total Payment:
${total_cop:,.2f} COP
 
{equals_line_simple}
 
 
"""
            
            # Display both receipts
            self.full_receipt_text.delete(1.0, tk.END)
            self.full_receipt_text.insert(1.0, full_receipt)
            
            self.simple_receipt_text.delete(1.0, tk.END)
            self.simple_receipt_text.insert(1.0, simple_receipt)
            
        except ValueError as e:
            messagebox.showerror("Input Error", "Please enter valid numeric values")
        except Exception as e:
            messagebox.showerror("Calculation Error", f"An error occurred: {str(e)}")
    
    def save_pdf(self):
        """Save both receipts as PDF"""
        if not self.current_data:
            messagebox.showwarning("No Data", "Please calculate first before saving")
            return
            
        try:
            # Create Receipts folder
            receipts_folder = os.path.join(os.getcwd(), "Receipts")
            os.makedirs(receipts_folder, exist_ok=True)
            
            # Generate filename
            date_str = datetime.now().strftime("%Y-%m-%d")
            filename = f"{self.current_data['model_id']} - {self.current_data['modelo']} - {self.current_data['tks']} - {date_str}.pdf"
            filepath = os.path.join(receipts_folder, filename)
            
            # Create PDF
            c = canvas.Canvas(filepath, pagesize=letter)
            width, height = letter
            
            # Add title
            c.setFont("Courier-Bold", 16)
            c.drawString(50, height - 50, "BROADSPEC PAYMENT RECEIPTS")
            
            # Add full receipt
            c.setFont("Courier", 9)
            y_position = height - 100
            full_text = self.full_receipt_text.get(1.0, tk.END)
            for line in full_text.split('\\n'):
                if y_position < 100:
                    c.showPage()
                    y_position = height - 50
                c.drawString(50, y_position, line[:80])
                y_position -= 12
            
            # New page for simple receipt
            c.showPage()
            c.setFont("Courier-Bold", 14)
            c.drawString(50, height - 50, "MODEL RECEIPT")
            
            c.setFont("Courier", 10)
            y_position = height - 100
            simple_text = self.simple_receipt_text.get(1.0, tk.END)
            for line in simple_text.split('\\n'):
                if y_position < 100:
                    break
                c.drawString(50, y_position, line[:80])
                y_position -= 14
            
            c.save()
            
            messagebox.showinfo("Success", f"PDF saved to:{os.linesep}{filepath}")
            
        except Exception as e:
            messagebox.showerror("Save Error", f"Failed to save PDF:{os.linesep}{str(e)}")
 
if __name__ == "__main__":
    root = tk.Tk()
    app = BroadSpecCalculator(root)
    root.mainloop()
'''
 
# Save the fixed GUI calculator
with open('broadspec_gui.py', 'w') as f:
    f.write(calculator_gui)
 
print("✓ Fixed broadspec_gui.py")
print("\nFixes:")
print("- Resolved f-string backslash syntax error")
print("- Fines now hidden from model screenshot when disabled (70% or 75%)")
print("- Only studio workers (60%) see fines in model receipt")